{
  "name": "doctor-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/doctor-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/doctor-service"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        },
        "production": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      }
    },
    "build-migrate": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/doctor-service-migrate",
        "format": [
          "cjs"
        ],
        "bundle": true,
        "main": "apps/doctor-service/src/migrate.ts",
        "tsConfig": "apps/doctor-service/tsconfig.app.json",
        "outputFileName": "migrate.js",
        "generatePackageJson": false,
        "external": [
          "@nestjs/microservices",
          "@nestjs/websockets",
          "class-transformer/storage"
        ]
      }
    },
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/doctor-service/package.json",
        "{workspaceRoot}/dist/apps/doctor-service/bun.lock"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/doctor-service/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "doctor-service:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "doctor-service:build:development"
        },
        "production": {
          "buildTarget": "doctor-service:build:production"
        }
      }
    },
    "migration-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d apps/doctor-service/src/app/configs/db/data-source.ts",
        "cwd": ".",
        "env": {
          "TS_NODE_PROJECT": "apps/doctor-service/tsconfig.app.json",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}"
        }
      }
    },
    "migration-revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d apps/doctor-service/src/app/configs/db/data-source.ts",
        "cwd": ".",
        "env": {
          "TS_NODE_PROJECT": "apps/doctor-service/tsconfig.app.json",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}"
        }
      }
    },
    "migration-show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d apps/doctor-service/src/app/configs/db/data-source.ts",
        "cwd": ".",
        "env": {
          "TS_NODE_PROJECT": "apps/doctor-service/tsconfig.app.json",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}"
        }
      }
    },
    "migration-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate apps/doctor-service/src/app/configs/db/migrations/auto-migration -d apps/doctor-service/src/app/configs/db/data-source.ts",
        "cwd": ".",
        "env": {
          "TS_NODE_PROJECT": "apps/doctor-service/tsconfig.app.json",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}"
        }
      }
    }
  }
}