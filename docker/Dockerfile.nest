# ============================================
# Base
# ============================================
FROM oven/bun:1.2-alpine AS base

WORKDIR /workspace


# ============================================
# Dependencies
# ============================================
FROM base AS dependencies

COPY package.json bun.lock ./
COPY nx.json tsconfig.base.json ./

COPY apps ./apps
COPY packages ./packages

RUN bun install --frozen-lockfile


# ============================================
# Builder
# ============================================
FROM dependencies AS builder

ARG APP_NAME

# Build normal application bundle
RUN bunx nx build ${APP_NAME} --configuration=production

# Build migration bundle only if this app has migrate.ts
RUN if [ -f "apps/${APP_NAME}/src/migrate.ts" ]; then \
      echo "Migration runner found for ${APP_NAME}. Building migrate.cjs..."; \
      bunx nx run ${APP_NAME}:build-migrate; \
      echo "Migration output files:"; \
      ls -la dist/apps/${APP_NAME}-migrate; \
      test -f dist/apps/${APP_NAME}-migrate/migrate.cjs; \
    else \
      echo "No migration runner found for ${APP_NAME}. Skipping migration build."; \
    fi

# Prepare runtime output
RUN mkdir -p /output \
    && cp -R dist/apps/${APP_NAME}/. /output/

# Copy migrate.cjs into image only if service has migrate.ts
RUN if [ -f "apps/${APP_NAME}/src/migrate.ts" ]; then \
      echo "Copying ${APP_NAME} migrate.cjs..."; \
      test -f dist/apps/${APP_NAME}-migrate/migrate.cjs; \
      cp dist/apps/${APP_NAME}-migrate/migrate.cjs /output/migrate.cjs; \
      test -f /output/migrate.cjs; \
      echo "Copied migrate.cjs to runtime output."; \
    else \
      echo "No migrate.cjs required for ${APP_NAME}."; \
    fi

RUN echo "Final output:" && ls -la /output

# ============================================
# Runtime
# ============================================
FROM oven/bun:1.2-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV TYPEORM_MIGRATION_MODE=bundle

ARG SOURCE_URL

LABEL org.opencontainers.image.source=${SOURCE_URL}

# Initial/simple approach:
# copy installed dependencies from builder.
#
# Later we can optimize this using Nx deployment pruning.
COPY --from=dependencies /workspace/node_modules ./node_modules

COPY --from=builder /output ./

USER bun

EXPOSE 3000

CMD ["bun", "main.js"]