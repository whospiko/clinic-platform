# ============================================
# Base
# ============================================
FROM oven/bun:1.2-alpine AS base

WORKDIR /workspace


# ============================================
# Dependencies
# ============================================
FROM base AS dependencies

COPY package.json bun.lock ./
COPY nx.json tsconfig.base.json ./

COPY apps ./apps
COPY packages ./packages

RUN bun install --frozen-lockfile


# ============================================
# Builder
# ============================================
FROM dependencies AS builder

ARG APP_NAME

# Build normal application bundle
RUN bunx nx build ${APP_NAME} --configuration=production

# Build migration bundle only if this app has migrate.ts
# Example: apps/booking-service/src/migrate.ts
RUN if [ -f "apps/${APP_NAME}/src/migrate.ts" ]; then \
      echo "Migration runner found for ${APP_NAME}. Building migrate.js..."; \
      bunx nx run ${APP_NAME}:build-migrate; \
    else \
      echo "No migration runner for ${APP_NAME}. Skipping migrate.js build."; \
    fi

# Prepare runtime output
RUN mkdir -p /output \
    && cp -R dist/apps/${APP_NAME}/. /output/

# Copy migrate.js into final output only when it exists
RUN if [ -f "dist/apps/${APP_NAME}-migrate/migrate.js" ]; then \
      cp dist/apps/${APP_NAME}-migrate/migrate.js /output/migrate.js; \
      echo "Copied migrate.js to runtime output."; \
    else \
      echo "No migrate.js generated for ${APP_NAME}."; \
    fi


# ============================================
# Runtime
# ============================================
FROM oven/bun:1.2-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV TYPEORM_MIGRATION_MODE=bundle

ARG SOURCE_URL

LABEL org.opencontainers.image.source=${SOURCE_URL}

# Initial/simple approach:
# copy installed dependencies from builder.
#
# Later we can optimize this using Nx deployment pruning.
COPY --from=dependencies /workspace/node_modules ./node_modules

COPY --from=builder /output ./

USER bun

EXPOSE 3000

CMD ["bun", "main.js"]